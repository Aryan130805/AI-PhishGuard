# PhishGuard Production Environment Configuration Template
# Instructions: Copy this file to '.env.prod' and configure the variables accordingly.
# Note: Keep the real '.env.prod' gitignored and never check it into the repository.

PROJECT_NAME=PhishGuard API
ENVIRONMENT=production

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-secure-production-password-1234
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=phishguard

# Redis settings
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Security (Generate a secure cryptographically random 32-byte hex string)
JWT_SECRET_KEY=replace-with-a-secure-32-byte-hex-string-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Email Generator Configuration
# Choose "openai" or "llama"
AI_PROVIDER=openai
OPENAI_API_KEY=your-production-openai-api-key-here
LLAMA_API_URL=http://localhost:11434/v1
LLAMA_API_KEY=llama

# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@phishguard.yourdomain.com
SMTP_PASSWORD=your-secure-smtp-app-password
SMTP_SECURE=True
SMTP_FROM_EMAIL=no-reply@phishguard.yourdomain.com

# Report storage directory
REPORTS_DIR=/app/reports
